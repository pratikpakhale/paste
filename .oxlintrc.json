{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
  "categories": { "correctness": "error", "suspicious": "warn", "perf": "warn" },
  "options": { "typeAware": true },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // The automatic JSX runtime (react-jsx) needs no React import.
    "react/react-in-jsx-scope": "off",
    // tsc's noImplicitReturns covers this and, unlike the lint, understands exhaustive switches.
    "typescript/consistent-return": "off",
    // The remaining assertions sit at untyped library boundaries (Dexie's typed-table idiom,
    // dnd-kit's `data`, Radix's string values) and are correct by construction.
    "typescript/no-unsafe-type-assertion": "off",
    // Omitting props via rest destructuring is intentional.
    "eslint/no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "fake-indexeddb/auto"] }],
    // Clips are user media with no caption tracks to offer.
    "jsx-a11y/media-has-caption": "off",
    // Keyboard-first app: rows and nav are driven by global shortcuts and the ⌘K palette, and the
    // clip list is an ARIA listbox (a native <select> can't hold sortable rich rows).
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    // Focus only moves in response to an explicit action (open composer, rename, edit).
    "jsx-a11y/no-autofocus": "off"
  },
  // Generated by shadcn and refreshed with `shadcn add`; local edits would be overwritten.
  "ignorePatterns": ["dist", "dev-dist", "src/components/ui"]
}
